# Copy to jarvis/.env and fill in. Never commit .env.

# Google OAuth client (Web application). Redirect URI must be BASE_URL + /auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the app is reached. Change when you deploy it.
BASE_URL=http://localhost:3000
PORT=3000
# 127.0.0.1 keeps it on this computer. Use 0.0.0.0 only behind HTTPS with JARVIS_PASSWORD set.
HOST=127.0.0.1
# Required when HOST is not 127.0.0.1. Browser asks for it (any username).
JARVIS_PASSWORD=

# How often to pull from Google, in seconds (minimum 15). Default 14400 = every 4 hours.
# JARVIS also pulls fresh data when you open the page, and from the Refresh button.
POLL_SECONDS=14400
# How many days of calendar to show
CALENDAR_DAYS=7
# Calendars to hide, matched against the calendar name (regular expression)
JARVIS_HIDE_CALENDARS=holiday|transferred from
# Rename calendars on screen: calendar-id=Name, comma separated. Your main calendar's id is your email.
# Example: JARVIS_CALENDAR_NAMES=robert@example.com=Luma
JARVIS_CALENDAR_NAMES=
# Other addresses that are you, comma separated (shown as "you", not as other people)
JARVIS_MY_EMAILS=
# Time zone for spoken answers
JARVIS_TZ=America/Toronto

# Optional: free-form questions answered by Claude
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
